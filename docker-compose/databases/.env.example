# Database Stack Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ──────────────────────────────────────────────
# MariaDB
# ──────────────────────────────────────────────
MARIADB_ROOT_PASSWORD=changeme_mariadb_root
MARIADB_DATABASE=homelab
MARIADB_USER=homelab
MARIADB_PASSWORD=changeme_mariadb
MARIADB_PORT=3306

# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_USER=homelab
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=homelab
POSTGRES_PORT=5432

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis
REDIS_PORT=6379