# GitLab CE Stack Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: GitLab CE is memory-hungry. Allocate at least 4 GB RAM
# (8 GB recommended) to the Docker host before deploying.

# Timezone (IANA format)
TZ=Europe/Athens

# === GitLab ===
# Hostname used inside the container
GITLAB_HOSTNAME=gitlab.local
# External URL advertised by GitLab (used by runners & clone links)
GITLAB_EXTERNAL_URL=https://gitlab.example.com
# Ports exposed on the host
GITLAB_HTTP_PORT=8080
GITLAB_HTTPS_PORT=8443
GITLAB_SSH_PORT=2222
# Shared memory for GitLab (raise if you hit "failed to allocate" errors)
GITLAB_SHM_SIZE=256m

# Omnibus config applied at container start. Override below as needed.
# By default HTTPS is enabled and a self-signed cert is generated.
GITLAB_OMNIBUS_CONFIG="
external_url '${GITLAB_EXTERNAL_URL}'
gitlab_rails['gitlab_shell_ssh_port'] = ${GITLAB_SSH_PORT}
nginx['redirect_http_to_https'] = true
puma['worker_processes'] = 2
sidekiq['concurrency'] = 10
postgresql['shared_buffers'] = '256MB'
prometheus_monitoring['enable'] = false
"

# === GitLab Runner ===
# Registration token from Admin -> CI/CD -> Runners (leave blank to
# register manually with: docker compose exec gitlab-runner gitlab-runner register)
GITLAB_RUNNER_TOKEN=
GITLAB_RUNNER_NAME=gitlab-docker-runner
# Default image used by the docker executor
GITLAB_RUNNER_DOCKER_IMAGE=docker:24-dind