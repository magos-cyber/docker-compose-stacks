# Jenkins Stack Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Jenkins requires at least 2 GB RAM; 4 GB+ recommended for busy controllers.
# Agents are lightweight; each needs ~512 MB.

# Timezone (IANA format)
TZ=Europe/Athens

# === Jenkins ===
# HTTP port exposed on host
JENKINS_HTTP_PORT=8080
# JNLP port for agent connections (must be reachable by agents)
JENKINS_JNLP_PORT=50000
# Container user/group IDs (match your host user to avoid permission issues on bind mounts)
JENKINS_USER_ID=1000
JENKINS_GROUP_ID=1000

# Jenkins controller Java options (heap, GC, etc.)
# JAVA_OPTS is already set in compose to skip wizard; add more here if desired.
# Example: JAVA_OPTS="-Djenkins.install.runSetupWizard=false -Xmx4g"

# === Jenkins Agent ===
# Default agent name if not overridden per container
JENKINS_AGENT_NAME=agent
# Secret for agent connection (leave blank; agent will retrieve from Jenkins
# UI after you create it there: Manage Jenkins -> Nodes -> New Node -> Agent)
JENKINS_AGENT_SECRET=
# Working directory inside agent container
JENKINS_AGENT_WORKDIR=/var/jenkins_agent