# Example environment variables for the Utility Services stack
# Copy this file to .env and edit the values as needed:
#   cp .env.example .env

# Timezone (IANA format)
TZ=Europe/Athens

# === Watchtower (auto-update) ===
# How often to check for container updates (seconds)
WATCHTOWER_INTERVAL=3600
# Only update images that have been available for at least this long since their release
WATCHTOWER_LIFETIME=24h
# Timeout (seconds) for a single update operation
WATCHTOWER_TIMEOUT=120
# Stop timeout (seconds) before killing an updated container
WATCHTOWER_STOP_TIMEOUT=120
# Do not start containers on Watchtower startup; only restart on updates
WATCHTOWER_NO_START=true

# === Dozzle (log viewer) ===
# Port Dozzle listens on inside the container
DOZZLE_PORT=8080
# Base URL path (e.g. behind a reverse proxy at /dozzle)
DOZZLE_BASE_URL=/

# === IT-Tools (dev tools) ===
# No configuration required; defaults to port 8080 inside the container

# === Stirling PDF ===
# Default system language (en_US, fr_FR, ...)
LANGUAGE=en_US