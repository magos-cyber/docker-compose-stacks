# Loki Stack Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Timezone (IANA format)
TZ=Europe/Athens

# === Loki ===
# Port Loki listens on
LOKI_PORT=3100

# === Grafana (for Loki) ===
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_strong_password
GRAFANA_ANON_ENABLED=false