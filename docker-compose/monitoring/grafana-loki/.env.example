# Loki Stack Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Timezone (IANA format)
TZ=Europe/Athens

# === Loki ===
# Port Loki listens on (external)
LOKI_PORT=3100

# === Grafana (for Loki) ===
GRAFANA_PORT=3000
# Admin credentials (CHANGE THESE!)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_strong_password
# Allow anonymous access to Grafana (set to false for production)
GRAFANA_ANON_ENABLED=false
# Root URL for Grafana (used in URLs/emails). Use https if behind a proxy
GRAFANA_ROOT_URL=http://localhost:3000