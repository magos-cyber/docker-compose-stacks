# Navidrome environment variables
# Copy this file to .env, fill in your values, then run:
#   cd docker-compose/media/navidrome && docker compose up -d

# --- Required ---
# Path to your music library (mounted read-only inside the container).
# Set this to the absolute path on your host, e.g. /mnt/media/music
ND_MUSICFOLDER=/music

# --- Optional: Spotify ---
# Get credentials at https://developer.spotify.com/dashboard
# ND_SPOTIFY_ID=
# ND_SPOTIFY_SECRET=

# --- Optional: Last.fm (scrobbling) ---
# Get API credentials at https://www.last.fm/api/account/create
# ND_LASTFM_APIKEY=
# ND_LASTFM_SECRET=

# --- Optional: public URL (for remote access / reverse proxy) ---
# ND_BASEURL=