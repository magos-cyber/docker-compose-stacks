# Immich Photo Management Stack
# Copy this file to .env and adjust values to your environment

# ============================================
# Immich Version
# ============================================
# Get the current release version from https://github.com/immich-app/immich/releases
IMMICH_VERSION=release

# ============================================
# Database Configuration
# ============================================
DB_PASSWORD=immich
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_DATA_LOCATION=./postgres

# ============================================
# Upload / Library Storage
# ============================================
# Path where uploaded photos and videos are stored
UPLOAD_LOCATION=./library

# ============================================
# Redis Configuration
# ============================================
REDIS_HOSTNAME=immich-redis

# ============================================
# JWT / Security
# ============================================
# Generate a secret with: openssl rand -base64 32
JWT_SECRET=change-me-with-a-random-secret-string

# ============================================
# Port
# ============================================
# Immich web UI port (default: 2283)
PORT=2283