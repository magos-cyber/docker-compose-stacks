# MinIO Stack Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# MinIO is lightweight; 1 GB RAM is sufficient for most workloads.
# Increase if you expect high request rates or large multipart uploads.

# Timezone (IANA format)
TZ=Europe/Athens

# === MinIO Server ===
# API port (S3-compatible)
MINIO_API_PORT=9000
# Console port (web UI)
MINIO_CONSOLE_PORT=9001
# Root user (like AWS root - has full access)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin  # CHANGE THIS!

# === Service User ===
# Password for the 'minio-user' service account created by the mc container
# This user gets readwrite policy on all buckets created during setup
MINIO_SERVICE_PASSWORD=changeme-service-pass  # CHANGE THIS!