# Authentik Stack Environment Variables
# Copy this file to .env and fill in the values
# cp .env.example .env

# === General ===
TZ=Europe/Athens
# Network interface to bind to (0.0.0.0 = all interfaces)
# AUTHENTIK_SERVER_HOST=0.0.0.0

# === Authentik Secret Key ===
# Generate a strong secret key:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUTHENTIK_SECRET_KEY=change-me

# === Authentik Server ===
# Web port (HTTP, internal API)
AUTHENTIK_SERVER_PORT=9000
# HTTPS port (external TLS termination)
AUTHENTIK_SERVER_PORT_HTTPS=9443
# Log level: debug, info, warning, error
AUTHENTIK_LOG_LEVEL=info

# === Authentik Worker ===
# Number of background worker processes
AUTHENTIK_WORKER_PROCESSES=1

# === PostgreSQL ===
AUTHENTIK_POSTGRES_NAME=authentik
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=change-me
AUTHENTIK_POSTGRES_HOST=postgres
AUTHENTIK_POSTGRES_PORT=5432

# === Redis ===
AUTHENTIK_REDIS_HOST=redis
AUTHENTIK_REDIS_PORT=6379
# Optional Redis password (leave empty for no auth)
# AUTHENTIK_REDIS_PASSWORD=