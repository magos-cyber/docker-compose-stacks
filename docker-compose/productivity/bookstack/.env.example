# BookStack Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Timezone (IANA format)
TZ=Europe/Athens

# === BookStack ===
# Public domain of your BookStack instance
BOOKSTACK_DOMAIN=wiki.example.com
# Port to expose locally (default: 8080)
BOOKSTACK_PORT=8080
# Laravel APP_KEY (generate with: head -c 32 /dev/urandom | base64)
BOOKSTACK_APP_KEY=
# Allow user registration (true/false)
BOOKSTACK_ALLOW_REGISTRATION=false
# Enable public link sharing (true/false)
BOOKSTACK_PUBLIC_SHARING=true
# Default viewing permission (authenticated|private)
BOOKSTACK_ALLOW_VIEWING=authenticated
# Default editing permission (authenticated|private)
BOOKSTACK_ALLOW_EDITING=authenticated
# Log level (debug|info|warning|error)
BOOKSTACK_LOG_LEVEL=info
# Bitly access token (optional, for short links)
BOOKSTACK_BITLY_TOKEN=

# === PostgreSQL Database ===
BOOKSTACK_DB_NAME=bookstack
BOOKSTACK_DB_USER=bookstack
BOOKSTACK_DB_PASSWORD=changeme_strong_db_password