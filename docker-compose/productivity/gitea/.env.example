# =============================================================================
# Gitea Self-Hosted Git Stack - Environment Configuration
# Copy this file to .env and adjust values to your environment.
# =============================================================================

# --- Gitea Server ---
GITEA_DOMAIN=git.example.com
GITEA_SSH_DOMAIN=git.example.com
GITEA_WEB_PORT=3000
GITEA_SSH_PORT=2222

# --- Gitea Service Settings ---
# Set to "true" to disable public registration (only admins can create users)
GITEA_DISABLE_REGISTRATION=true
# Set to "true" to require sign-in to view any page
GITEA_REQUIRE_SIGNIN=false

# --- Database (PostgreSQL) ---
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=change-me-please-use-a-strong-password